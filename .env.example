# Configuração do modelo (endpoint OpenAI-compatível)
# O padrão é o OpenCode Go com DeepSeek. Para outro modelo, use a alternativa comentada abaixo.
OPENCODE_API_KEY=sua_chave_aqui
OPENCODE_BASE_URL=https://opencode.ai/inference/go/v1
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_MAX_TOKENS=32000

# Alternativa: OpenCode Zen com Gemini 2.5 Pro
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_MODEL=gemini-2.5-pro
